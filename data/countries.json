{
 "_about": "Country and continent register. ISO 3166-1 alpha-2 codes with UN geoscheme subregions. Flag imagery is generated at runtime from Unicode regional-indicator sequences, so no third-party flag artwork is bundled or hot-linked.",
 "continents": [
  {
   "id": "africa",
   "name": "Africa",
   "latin": "Africa",
   "plate": "I",
   "note": "The last continent where megafauna still moves in numbers — and where the margin is thinnest.",
   "blurb": "Africa holds the world's last great assemblages of large mammals, and the only places on Earth where a Pleistocene-scale food web still runs more or less intact. It also holds the fastest-shrinking of them. Records below draw on IUCN Red List assessments, the African Elephant and Rhino Specialist Groups, and national red data books."
  },
  {
   "id": "asia",
   "name": "Asia",
   "latin": "Asia",
   "plate": "II",
   "note": "More Critically Endangered vertebrates than any other landmass. Also more people.",
   "blurb": "Asia's extinction crisis is concentrated and severe: Sundaland's forests, the Mekong's rivers and the coastal seas of the Coral Triangle each hold species now counted in dozens rather than thousands. Assessments here lean on IUCN Specialist Group surveys, the China Species Red List, and India's national census programmes."
  },
  {
   "id": "europe",
   "name": "Europe",
   "latin": "Europa",
   "plate": "III",
   "note": "A continent that lost its megafauna early — and is, in places, slowly getting some of it back.",
   "blurb": "Europe's baseline shifted centuries ago, so its red lists read differently: fewer megafauna, far more freshwater fish, molluscs and pollinators. It is also the continent with the best-documented recoveries. Data follow the European Red List regional assessments alongside national red data books."
  },
  {
   "id": "north-america",
   "name": "North America",
   "latin": "America Septentrionalis",
   "plate": "IV",
   "note": "Where the Endangered Species Act and NatureServe G-ranks add a second, finer lens.",
   "blurb": "North America layers three systems: the global IUCN Red List, the United States Endangered Species Act and Canada's SARA listings, and NatureServe's G1–G5 conservation ranks. Where a species carries more than one, all are shown — they frequently disagree, and the disagreement is itself informative."
  },
  {
   "id": "south-america",
   "name": "South America",
   "latin": "America Meridionalis",
   "plate": "V",
   "note": "The richest continent for birds and amphibians, and the least completely assessed.",
   "blurb": "South America contains more described vertebrates than any other continent, and the largest share of Data Deficient ones. Amphibian declines here are the steepest recorded anywhere on Earth. Sources include IUCN assessments, Brazil's ICMBio red book, and Andean national listings."
  },
  {
   "id": "oceania",
   "name": "Oceania",
   "latin": "Oceania",
   "plate": "VI",
   "note": "Island endemism at its most extreme: the highest extinction rate per unit of land on Earth.",
   "blurb": "Oceania's species evolved without mammalian predators and, in many cases, without the means to escape them. The region has recorded more bird and mammal extinctions since 1500 than any other. It is also where island eradication and translocation programmes have produced the most dramatic single-species rescues in the historical record."
  },
  {
   "id": "antarctica",
   "name": "Antarctica",
   "latin": "Terra Australis",
   "plate": "VII",
   "note": "No countries. No red list of its own. A treaty, a fishery, and a warming sea.",
   "blurb": "Antarctica has no sovereign states and therefore no national red list. Its species are governed by the Antarctic Treaty System and CCAMLR, and assessed globally by the IUCN. The threats are krill fishery expansion and, above all, the loss of the fast ice that emperor penguins breed on."
  }
 ],
